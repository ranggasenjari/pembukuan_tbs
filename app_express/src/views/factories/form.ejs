<%- include('../partials/header') %>
<% const item = factory || {}; const types = item.factory_spsi_types?.length ? item.factory_spsi_types : [{ name: '', calculation_mode: 'PER_KG', amount: 0 }]; const prices = item.factory_prices?.length ? item.factory_prices : [{ name: '', price: 0, is_default: false }]; %>
<div class="page-head"><div><p class="eyebrow">Master Data</p><h1><%= factory ? 'Edit Pabrik' : 'Tambah Pabrik' %></h1></div><a href="<%= url(factory ? `/factories/${factory.id}` : '/factories') %>" class="btn-secondary">Kembali</a></div>
<form method="post" action="<%= url(factory ? `/factories/${factory.id}?_method=PUT` : '/factories') %>" class="space-y-5">
<section class="form-card"><h2>Data Pabrik</h2><div class="grid gap-4 md:grid-cols-2"><label><span class="form-label">Nama Pabrik</span><input required name="name" value="<%= item.name || '' %>" class="form-input uppercase"></label><label><span class="form-label">Alamat</span><input name="address" value="<%= item.address || '' %>" class="form-input uppercase"></label></div></section>
<section class="form-card"><div class="flex items-center justify-between"><h2>Jenis SPSI</h2><button type="button" id="add-spsi" class="btn-secondary small">Tambah Jenis</button></div><div id="spsi-types" class="mt-4 space-y-3"><% types.forEach((type) => { %><div class="grid gap-3 md:grid-cols-[1fr_160px_220px_48px]"><input required name="spsi_name" value="<%= type.name || '' %>" class="form-input uppercase" placeholder="Nama Jenis"><select name="spsi_mode" class="form-input"><option value="PER_KG" <%= type.calculation_mode === 'PER_KG' ? 'selected' : '' %>>Per/Kg</option><option value="FIX" <%= type.calculation_mode === 'FIX' ? 'selected' : '' %>>Fix</option></select><input required min="0" name="spsi_amount" value="<%= type.amount || 0 %>" type="number" class="form-input" placeholder="Nominal"><button type="button" class="remove-spsi btn-secondary small">Hapus</button></div><% }) %></div></section>
<section class="form-card"><div class="flex items-center justify-between"><h2>Harga Hari Ini</h2><button type="button" id="add-price" class="btn-secondary small">Tambah Harga</button></div><div id="factory-prices" class="mt-4 space-y-3"><% prices.forEach((p) => { %><div class="price-row grid gap-3 md:grid-cols-[1fr_160px_80px_48px] items-center"><input required name="price_name" value="<%= p.name || '' %>" class="form-input uppercase" placeholder="Jenis"><input required min="0" name="price_value" value="<%= p.price || 0 %>" type="number" class="form-input" placeholder="Harga"><label class="flex items-center gap-1 text-sm"><input type="checkbox" name="price_default" value="1" <%= p.is_default ? 'checked' : '' %>> Default</label><button type="button" class="remove-price rounded-lg bg-rose-50 text-rose-700 px-2 py-1 text-sm">×</button></div><% }) %></div></section>
<button class="btn-primary">Simpan Pabrik</button></form>
<script>
document.getElementById('add-spsi')?.addEventListener('click',()=>{const row=document.createElement('div');row.className='grid gap-3 md:grid-cols-[1fr_160px_220px_48px]';row.innerHTML='<input required name="spsi_name" class="form-input uppercase" placeholder="Nama Jenis"><select name="spsi_mode" class="form-input"><option value="PER_KG">Per/Kg</option><option value="FIX">Fix</option></select><input required min="0" name="spsi_amount" value="0" type="number" class="form-input" placeholder="Nominal"><button type="button" class="remove-spsi btn-secondary small">Hapus</button>';document.getElementById('spsi-types').appendChild(row)});
document.getElementById('add-price')?.addEventListener('click',()=>{const row=document.createElement('div');row.className='price-row grid gap-3 md:grid-cols-[1fr_160px_80px_48px] items-center';row.innerHTML='<input required name="price_name" class="form-input uppercase" placeholder="Jenis"><input required min="0" name="price_value" value="0" type="number" class="form-input" placeholder="Harga"><label class="flex items-center gap-1 text-sm"><input type="checkbox" name="price_default" value="1"> Default</label><button type="button" class="remove-price rounded-lg bg-rose-50 text-rose-700 px-2 py-1 text-sm">×</button>';document.getElementById('factory-prices').appendChild(row)});
document.addEventListener('click',(e)=>{if(e.target.classList.contains('remove-spsi'))e.target.closest('div.grid')?.remove();if(e.target.classList.contains('remove-price'))e.target.closest('.price-row')?.remove();});
</script>
<%- include('../partials/footer') %>
