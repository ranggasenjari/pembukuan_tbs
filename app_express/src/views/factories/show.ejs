<%- include('../partials/header') %>
<div class="page-head"><div><p class="eyebrow">Pabrik</p><h1><%= factory.name %></h1></div><div class="flex gap-2"><a href="<%= url(`/factories/${factory.id}/edit`) %>" class="btn-secondary">Edit</a><a href="<%= url('/factories') %>" class="btn-secondary">Kembali</a></div></div>
<section class="form-card"><dl class="detail-grid"><dt>Alamat</dt><dd><%= factory.address || '-' %></dd></dl></section>
<section class="form-card mt-5"><h2>Jenis SPSI</h2><div class="table-card flush"><table><thead><tr><th>Jenis</th><th>Perhitungan</th><th>Nominal</th></tr></thead><tbody><% if (!(factory.factory_spsi_types || []).length) { %><tr><td colspan="3" class="empty">Belum ada jenis SPSI.</td></tr><% } %><% (factory.factory_spsi_types || []).forEach((type) => { %><tr><td><%= type.name %></td><td><%= type.calculation_mode === 'FIX' ? 'Fix' : 'Per/Kg' %></td><td><%= format.currency(type.amount) %></td></tr><% }) %></tbody></table></div></section>
<section class="form-card mt-5"><h2>Harga Hari Ini</h2><div class="table-card flush"><table><thead><tr><th>Jenis</th><th>Harga</th><th>Default</th></tr></thead><tbody><% if (!(factory.factory_prices || []).length) { %><tr><td colspan="3" class="empty">Belum ada harga.</td></tr><% } %><% (factory.factory_prices || []).forEach((p) => { %><tr><td><%= p.name %></td><td><%= format.currency(p.price) %></td><td><%= p.is_default ? '✓' : '-' %></td></tr><% }) %></tbody></table></div></section>
<form method="post" action="<%= url(`/factories/${factory.id}?_method=DELETE`) %>" data-confirm="Hapus pabrik ini?" class="mt-5"><button class="link danger">Hapus Pabrik</button></form>
<%- include('../partials/footer') %>
