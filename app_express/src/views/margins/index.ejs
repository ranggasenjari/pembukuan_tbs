<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Keuangan</p>
    <h1>Margin / Offtaker</h1>
  </div>
  <a href="/margins/new" class="btn-primary">Input Margin</a>
</div>
<form class="filter-bar">
  <input type="date" name="start" value="<%= filters.start || '' %>" class="form-input compact">
  <input type="date" name="end" value="<%= filters.end || '' %>" class="form-input compact">
  <button class="btn-secondary">Filter</button>
</form>
<div class="table-card">
  <table>
    <thead><tr><th>Tanggal</th><th>Offtaker</th><th>Real</th><th>Margin</th><th></th></tr></thead>
    <tbody>
      <% if (!margins.length) { %><tr><td colspan="5" class="empty">Belum ada margin.</td></tr><% } %>
      <% margins.forEach((margin) => { %>
        <tr>
          <td><%= format.date(margin.transaction_date) %></td>
          <td><%= format.currency(margin.offtaker_amount) %></td>
          <td><%= format.currency(margin.real_amount) %></td>
          <td class="font-bold text-emerald-700"><%= format.currency(margin.margin_amount) %></td>
          <td class="text-right">
            <a href="/margins/<%= margin.id %>/edit" class="link">Edit</a>
            <form method="post" action="/margins/<%= margin.id %>?_method=DELETE" data-confirm="Hapus margin ini?" class="inline"><button class="link danger">Hapus</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
