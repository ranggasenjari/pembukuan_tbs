<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Operasional Terpusat <span id="realtime-status" style="font-size:10px;vertical-align:middle;margin-left:4px" title="Realtime">○</span></p>
    <h1>Manajemen Bon</h1>
  </div>
  <div class="head-actions">
    <button type="button" id="btn-select-mode" class="btn-secondary">Pilih Gabung</button>
    <button type="button" id="btn-merge" class="btn-primary" style="display:none">Gabung Nota</button>
    <a href="<%= url('/bons/new') %>" class="btn-primary">Tambah Bon</a>
  </div>
</div>

<form class="filter-bar">
  <input type="date" name="start" value="<%= filters.start || '' %>" class="form-input compact">
  <input type="date" name="end" value="<%= filters.end || '' %>" class="form-input compact">
  <input name="q" value="<%= filters.q || '' %>" class="form-input compact" placeholder="Tiket, driver, plat, relasi">
  <select name="status" class="form-input compact">
    <option value="">Semua Status</option>
    <% ['BELUM_DIBAYAR','TERTAGIH','LUNAS'].forEach((status) => { %>
      <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= format.bonStatusLabel(status) %></option>
    <% }) %>
  </select>
  <select name="factory_id" class="form-input compact">
    <option value="">Semua Pabrik</option>
    <% factories.forEach((factory) => { %>
      <option value="<%= factory.id %>" <%= filters.factory_id === factory.id ? 'selected' : '' %>><%= factory.name %></option>
    <% }) %>
  </select>
  <button class="btn-secondary">Filter</button>
</form>

<section class="stats-mini">
  <div class="stat-mini"><span>Bon</span><strong><%= format.number(summary.totalBons) %></strong></div>
  <div class="stat-mini"><span>Belum Nota</span><strong><%= format.number(summary.unbilledBons) %></strong></div>
  <div class="stat-mini"><span>Belum Bayar</span><strong><%= format.number(summary.billedBons) %></strong></div>
  <div class="stat-mini"><span>Tonase</span><strong><%= format.number(summary.totalTonnage) %> t</strong></div>
</section>

<% if (!items.length) { %>
  <section class="form-card"><p class="empty">Belum ada data bon untuk filter ini.</p></section>
<% } %>

<div class="bon-management-list">
  <% items.forEach(({ bon, paymentRelation, nota, payments }) => { %>
    <% const locked = bon.status === 'LUNAS'; %>
    <% const bpVal = bon.bp_colt ?? 100000; %>
    <% const firstPayment = (payments || [])[0]; %>
    <% const deductions = bon.bon_deductions || []; %>
    <article class="management-card <%= locked ? 'locked' : '' %>" data-bon-id="<%= bon.id %>" data-factory-id="<%= bon.factory_id || '' %>">
      <section class="management-segment bon-segment">
        <div class="segment-head">
          <span class="segment-title-label">Bon Timbangan <span class="ticket-tag"><%= bon.ticket_number || '-' %></span></span>
          <span class="select-area">
            <label class="merge-check" title="Pilih untuk digabung">
              <input type="checkbox" class="merge-select" <%= locked ? 'disabled' : '' %>>
              <span class="merge-checkmark"></span>
            </label>
            <span class="status <%= String(bon.status || '').toLowerCase() %>"><%= bon.status === 'BELUM_DIBAYAR' ? 'Belum Nota' : bon.status === 'TERTAGIH' ? 'Belum Bayar' : 'Lunas' %></span>
          </span>
        </div>
        <div class="ticket-row">
          <div class="flex items-center gap-1">
            <% if (bon.image_url) { %>
              <button class="bon-image-preview" data-url="<%= bon.image_url %>" title="Lihat foto" style="border:1px solid #e2e8f0;background:#fff;cursor:pointer;padding:0 4px;color:#94a3b8;font-size:11px;line-height:1.5;border-radius:4px">📷</button>
            <% } %>
            <strong><%= bon.plate_number %></strong>
          </div>
          <span><%= format.date(bon.bon_date) %></span>
        </div>

        <div class="bm-row row-1">
          <% if (locked) { %>
            <label class="bm-field rel-locked-field"><span>Relasi</span><div class="rel-locked"><%= bon.relation_agents?.name || bon.relation_name || '-' %></div></label>
            <label class="bm-field"><span>Plat</span><div class="rel-locked"><%= bon.plate_number %></div></label>
            <label class="bm-field"><span>Driver</span><div class="rel-locked"><%= bon.driver_name || '-' %></div></label>
          <% } else { %>
            <div class="rel-cell">
              <span>Relasi</span>
              <div class="rel-select-wrap">
                <select name="relation_agent_id" class="bm-input">
                  <option value="">— Pilih Relasi —</option>
                  <% relationAgents.forEach((agent) => { %>
                    <option value="<%= agent.id %>" <%= bon.relation_agent_id === agent.id ? 'selected' : '' %>><%= agent.name %></option>
                  <% }) %>
                </select>
                <button type="button" class="bm-add-rel" title="Tambah Relasi">+</button>
              </div>
            </div>
            <label class="bm-field plat"><span>Plat</span><input name="plate_number" value="<%= bon.plate_number || '' %>" class="bm-input uppercase" <%= locked ? 'readonly' : '' %>></label>
            <label class="bm-field driver"><span>Driver</span><input name="driver_name" value="<%= bon.driver_name || '' %>" class="bm-input uppercase" <%= locked ? 'readonly' : '' %>></label>
          <% } %>
        </div>

        <% if (!locked) { %>
          <div class="rel-add-form" style="display:none">
            <input required name="new_relation_name" class="bm-input uppercase" placeholder="Nama Relasi">
            <input name="new_relation_address" class="bm-input uppercase" placeholder="Alamat (opsional)">
          </div>
        <% } %>

        <div class="bm-row row-2">
          <label class="bm-field n1"><span>N1</span><input name="netto_1" value="<%= bon.netto_1 || 0 %>" class="bm-input number" <%= locked ? 'readonly' : '' %>></label>
          <label class="bm-field n2"><span>N2</span><input name="netto_2" value="<%= bon.netto_2 || 0 %>" class="bm-input number" <%= locked ? 'readonly' : '' %>></label>
          <label class="bm-field harga"><span>Harga</span><input name="price" value="<%= bon.price || 0 %>" class="bm-input number" <%= locked ? 'readonly' : '' %>></label>
          <label class="bm-field spsi"><span>SPSI</span>
            <select name="factory_spsi_type_id" class="bm-input" <%= locked ? 'disabled' : '' %>>
              <option value="">-</option>
              <% factories.forEach((factory) => { %>
                <% if (factory.id === bon.factory_id) { %>
                  <% (factory.factory_spsi_types || []).forEach((type) => { %>
                    <option value="<%= type.id %>" data-mode="<%= type.calculation_mode || 'PER_KG' %>" data-rate="<%= type.amount || 0 %>" <%= bon.factory_spsi_type_id === type.id ? 'selected' : '' %>><%= type.name %></option>
                  <% }) %>
                <% } %>
              <% }) %>
            </select>
          </label>
          <label class="bm-field uminum"><span>U.Minum</span><input name="uang_minum" value="<%= bon.uang_minum || 0 %>" class="bm-input number" <%= locked ? 'readonly' : '' %>></label>
        </div>

        <div class="bm-row row-3">
          <label class="bm-field dp"><span>DP</span><input name="dp" value="<%= bon.dp || 0 %>" class="bm-input number" <%= locked ? 'readonly' : '' %>></label>
          <div class="bm-field bp-field">
            <span>BP</span>
            <div class="bp-pills-inline">
              <% [0, 50000, 70000, 100000, 150000].forEach((val) => { %>
                <button type="button" class="bm-bp <%= bpVal == val ? 'active' : '' %>" data-value="<%= val %>" <%= locked ? 'disabled' : '' %>><%= val / 1000 %></button>
              <% }) %>
              <input type="hidden" name="bp_colt" value="<%= bpVal %>" class="bm-input">
            </div>
          </div>
          <label class="bm-field pph-field">
            <span>PPh</span>
            <button type="button" class="bm-pph <%= bon.pph > 0 ? 'active' : '' %>" data-enabled="<%= bon.pph > 0 ? '1' : '0' %>" <%= locked ? 'disabled' : '' %>><%= bon.pph > 0 ? 'ON' : 'OFF' %></button>
          </label>
          <label class="bm-field notes-field"><span>Catatan</span><input name="notes" value="<%= bon.notes || '' %>" class="bm-input" <%= locked ? 'readonly' : '' %> placeholder="Ringkas"></label>
        </div>

        <div class="bm-field ded-field">
          <span>Potongan Lain</span>
          <% if (locked) { %>
            <% if (deductions.length) { %>
              <div class="mini-list">
                <% deductions.forEach((d) => { %>
                  <div><strong><%= d.label || 'Potongan' %></strong> <%= format.currency(d.amount) %></div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="muted-line">-</div>
            <% } %>
          <% } else { %>
            <div class="ded-list">
              <% if (deductions.length) { %>
                <% deductions.forEach((d, i) => { %>
                  <div class="ded-row">
                    <input name="deduction_label" value="<%= d.label || '' %>" class="bm-input" placeholder="Label">
                    <input name="deduction_amount" value="<%= d.amount || 0 %>" class="bm-input number" placeholder="Rp">
                    <button type="button" class="ded-remove" title="Hapus">&times;</button>
                    <button type="button" class="ded-add" title="Tambah Potongan">+</button>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="ded-row">
                  <input name="deduction_label" value="" class="bm-input" placeholder="Label">
                  <input name="deduction_amount" value="" class="bm-input number" placeholder="Rp">
                  <button type="button" class="ded-remove" title="Hapus">&times;</button>
                  <button type="button" class="ded-add" title="Tambah Potongan">+</button>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>

        <div class="total-row">
          <span>Total</span>
          <strong class="bon-total"><%= format.currency(bon.total) %></strong>
          <% if (!locked) { %><button type="button" class="btn-primary small bm-save" style="display:none">Simpan Bon</button><% } %>
        </div>
      </section>

      <section class="management-segment relation-segment">
        <div class="segment-head">
          <span>Relasi Bayar</span>
          <i data-lucide="hand-coins"></i>
        </div>
        <% if (paymentRelation) { %>
          <div class="segment-title"><%= paymentRelation.name %></div>
          <div class="muted-line"><%= paymentRelation.contact || '-' %></div>
          <div class="muted-line"><%= paymentRelation.address || '-' %></div>
          <% const accounts = paymentRelation.payment_relation_accounts || []; %>
          <% if (accounts.length) { %>
            <div class="mini-list">
              <% accounts.forEach((account) => { %>
                <div><strong><%= account.bank_name || '-' %></strong> <%= account.account_number || '-' %><br><small><%= account.account_name || '-' %></small></div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="muted-line">Belum ada rekening.</p>
          <% } %>
        <% } else { %>
          <p class="muted-line">Belum ada relasi bayar terhubung ke plat ini.</p>
        <% } %>
        <% if (!locked) { %>
          <div class="payment-block">
            <div class="sub-head">Hubungkan Relasi Bayar</div>
            <form method="post" action="<%= url(`/bon-management/bons/${bon.id}/payment-relation`) %>" class="inline-stack">
              <select required name="payment_relation_id" class="bm-input">
                <option value="">Pilih Relasi Bayar</option>
                <% paymentRelations.forEach((relation) => { %>
                  <option value="<%= relation.id %>"><%= relation.name %></option>
                <% }) %>
              </select>
              <button class="btn-secondary small">Hubungkan Plat</button>
            </form>
            <details class="inline-create">
              <summary>Tambah Relasi Bayar Baru</summary>
              <form method="post" action="<%= url(`/bon-management/bons/${bon.id}/payment-relation/new`) %>" class="inline-stack">
                <div class="pr-half">
                  <input required name="name" class="bm-input uppercase" placeholder="Nama Relasi Bayar">
                  <input name="contact" class="bm-input" placeholder="Kontak">
                </div>
                <input name="address" class="bm-input uppercase" placeholder="Alamat / Asal">
                <textarea name="notes" rows="2" class="bm-input" placeholder="Catatan"></textarea>
                <div class="pr-third">
                  <input name="bank_name" class="bm-input uppercase" placeholder="Nama Bank">
                  <input name="account_number" class="bm-input" placeholder="No Rekening">
                  <input name="account_name" class="bm-input uppercase" placeholder="Nama Rekening">
                </div>
                <button class="btn-primary small">Simpan & Hubungkan</button>
              </form>
            </details>
          </div>
        <% } %>
      </section>

      <section class="management-segment nota-segment" data-nota-id="<%= nota?.id || '' %>">
        <div class="segment-head">
          <span>Nota & Pembayaran</span>
          <i data-lucide="file-text"></i>
        </div>
        <% if (nota) { %>
          <div class="segment-title"><%= nota.invoice_number %></div>
          <div class="muted-line"><%= format.currency(nota.total_amount) %></div>
          <span class="status <%= String(nota.status || '').toLowerCase() %>"><%= format.notaStatusLabel(nota.status) %></span>
          <div class="action-row">
            <button type="button" class="btn-secondary small bm-recalc">Recalc</button>
            <button type="button" class="btn-secondary small bm-wa">WA</button>
          </div>
        <% } else { %>
          <p class="muted-line">Bon belum masuk nota.</p>
          <form method="post" action="<%= url(`/bon-management/bons/${bon.id}/nota`) %>">
            <button class="btn-primary small" <%= bon.status !== 'BELUM_DIBAYAR' ? 'disabled' : '' %>>Buat Nota</button>
          </form>
        <% } %>

        <div class="payment-block">
          <div class="sub-head">Pembayaran</div>
          <% if (firstPayment) { %>
            <div class="segment-title"><%= format.currency(firstPayment.amount_paid) %></div>
            <div class="muted-line"><%= format.date(firstPayment.payment_date) %></div>
            <% if (firstPayment.proof_url) { %><a class="link" href="<%= firstPayment.proof_url %>" target="_blank">Lihat Bukti</a><% } %>
          <% } else if (nota) { %>
            <form method="post" enctype="multipart/form-data" action="<%= url(`/bon-management/notas/${nota.id}/payments`) %>" class="inline-stack">
              <div class="pay-row">
                <input required type="date" name="payment_date" value="<%= today %>" class="bm-input">
                <input required type="number" name="amount_paid" value="<%= nota.total_amount || bon.total || '' %>" class="bm-input number" placeholder="Nominal">
              </div>
              <input required type="file" name="proof" accept="image/*" class="bm-input file">
              <button class="btn-primary small">Simpan Bayar</button>
            </form>
          <% } else { %>
            <p class="muted-line">Buat nota dulu sebelum input pembayaran.</p>
          <% } %>
        </div>
      </section>
    </article>
  <% }) %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const appUrl = window.appUrl || ((path) => path);
  const money = (value) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(value || 0));

  const selectModeBtn = document.getElementById('btn-select-mode');
  const mergeBtn = document.getElementById('btn-merge');
  let selectMode = false;

  const updateMergeState = () => {
    const selected = Array.from(document.querySelectorAll('.merge-select:checked')).map((box) => box.closest('.management-card').dataset.bonId);
    const any = selected.length > 0;
    document.querySelectorAll('.management-card').forEach((card) => {
      const box = card.querySelector('.merge-select');
      if (!box) return;
      if (selectMode) card.classList.toggle('selectable', !box.disabled);
      card.classList.toggle('selected', !box.disabled && box.checked);
    });
    if (mergeBtn) {
      mergeBtn.style.display = any ? 'inline-flex' : 'none';
      mergeBtn.textContent = `Gabung Nota (${selected.length})`;
    }
    if (selectModeBtn) selectModeBtn.classList.toggle('active', selectMode);
  };

  if (selectModeBtn) selectModeBtn.addEventListener('click', () => {
    selectMode = !selectMode;
    document.querySelectorAll('.merge-select:checked').forEach((box) => { box.checked = false; });
    updateMergeState();
  });

  document.querySelectorAll('.merge-select').forEach((box) => {
    box.addEventListener('change', updateMergeState);
  });

  document.querySelectorAll('.management-card').forEach((card) => {
    const box = card.querySelector('.merge-select');
    if (!box || box.disabled) return;

    const MOVE_TOLERANCE = 10;
    let pressTimer = null;
    let pressing = false;
    let pressMoved = false;
    let justActivated = false;
    let pressStartX = 0;
    let pressStartY = 0;

    const startPress = (event) => {
      if (event.button !== 0) return;
      pressing = true;
      pressMoved = false;
      justActivated = false;
      pressStartX = event.clientX;
      pressStartY = event.clientY;
      if (!selectMode) {
        clearTimeout(pressTimer);
        pressTimer = setTimeout(() => {
          if (pressMoved || box.disabled) return;
          selectMode = true;
          justActivated = true;
          box.checked = true;
          updateMergeState();
        }, 450);
      }
    };

    const handleMove = (event) => {
      if (!pressing) return;
      if (Math.abs(event.clientX - pressStartX) > MOVE_TOLERANCE ||
          Math.abs(event.clientY - pressStartY) > MOVE_TOLERANCE) {
        pressMoved = true;
        clearTimeout(pressTimer);
      }
    };

    const endPress = (event) => {
      const wasMoved = pressMoved;
      const wasJustActivated = justActivated;
      clearTimeout(pressTimer);
      pressing = false;
      pressMoved = false;
      justActivated = false;
      if (selectMode && !wasMoved && !wasJustActivated && !box.disabled) {
        if (!event.target.closest('.merge-check')) {
          box.checked = !box.checked;
          updateMergeState();
        }
      }
    };

    const cancelPress = () => {
      clearTimeout(pressTimer);
      pressing = false;
      pressMoved = false;
      justActivated = false;
    };

    card.addEventListener('pointerdown', startPress);
    card.addEventListener('pointermove', handleMove);
    card.addEventListener('pointerup', endPress);
    card.addEventListener('pointercancel', cancelPress);
    card.addEventListener('pointerleave', cancelPress);
    card.querySelector('.merge-check').addEventListener('click', (event) => event.stopPropagation());
  });

  if (mergeBtn) mergeBtn.addEventListener('click', async () => {
    const selected = Array.from(document.querySelectorAll('.merge-select:checked')).map((box) => box.closest('.management-card').dataset.bonId);
    if (selected.length < 2) return;
    const payload = { bon_ids: selected };
    try {
      const response = await fetch(appUrl('/notas/merge'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await response.json();
      if (!response.ok || !result.ok) {
        const message = result.error || 'Gagal menggabung bon';
        if (/relasi/i.test(message) && !payload.relation_agent_id) {
          const agentId = prompt(`${message}\nPilih ID relasi (kosongkan bila ingin lanjut):`);
          if (!agentId) return;
          payload.relation_agent_id = agentId;
          return mergeBtn.click();
        }
        throw new Error(message);
      }
      window.location.href = appUrl(`/notas/${result.nota.id}`);
    } catch (error) {
      alert(error.message);
    }
  });

  document.querySelectorAll('.management-card').forEach((card) => {
    const saveButton = card.querySelector('.bm-save');
    const ZERO_FACTORY = 'a536e3c0-7ea0-4003-9df0-c38721a9439b';

    const recalcTotal = () => {
      const n1 = Number(card.querySelector('[name="netto_1"]')?.value) || 0;
      const n2 = Number(card.querySelector('[name="netto_2"]')?.value) || 0;
      const price = Number(card.querySelector('[name="price"]')?.value) || 0;
      const dp = Number(card.querySelector('[name="dp"]')?.value) || 0;
      const um = Number(card.querySelector('[name="uang_minum"]')?.value) || 0;
      const bp = Number(card.querySelector('[name="bp_colt"]')?.value) || 0;

      const spsiSelect = card.querySelector('[name="factory_spsi_type_id"]');
      const spsiOption = spsiSelect?.options[spsiSelect.selectedIndex];
      const spsiMode = String(spsiOption?.dataset.mode || 'PER_KG').toUpperCase();
      const spsiRate = Number(spsiOption?.dataset.rate) || 0;
      const spsiAmount = spsiMode === 'FIX' ? spsiRate : spsiRate * n1;

      const zero = card.dataset.factoryId === ZERO_FACTORY;
      const pphBtn = card.querySelector('.bm-pph');
      const pphOn = pphBtn && !pphBtn.disabled && pphBtn.dataset.enabled === '1';
      const pph = zero ? 0 : (pphOn ? Math.floor(0.0025 * price * n2) : 0);
      const umValue = zero ? 0 : um;

      let deductionTotal = 0;
      card.querySelectorAll('[name="deduction_amount"]').forEach((inp) => { deductionTotal += Number(inp.value) || 0; });

      const total = (price * n2) - (dp + spsiAmount + bp + pph + umValue + deductionTotal);
      const totalEl = card.querySelector('.bon-total');
      if (totalEl) totalEl.textContent = money(total);
    };

    const inputs = card.querySelectorAll('.bon-segment .bm-input');
    inputs.forEach((input) => {
      input.addEventListener('input', () => {
        if (saveButton) saveButton.style.display = 'inline-flex';
        if (input.classList.contains('uppercase')) input.value = input.value.toUpperCase();
        recalcTotal();
      });
      input.addEventListener('change', () => {
        if (saveButton) saveButton.style.display = 'inline-flex';
        recalcTotal();
      });
    });

    card.querySelectorAll('.bm-bp').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.disabled) return;
        card.querySelectorAll('.bm-bp').forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        card.querySelector('[name="bp_colt"]').value = button.dataset.value;
        if (saveButton) saveButton.style.display = 'inline-flex';
        recalcTotal();
      });
    });

    card.querySelectorAll('.bm-pph').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.disabled) return;
        const on = button.dataset.enabled !== '1';
        button.dataset.enabled = on ? '1' : '0';
        button.textContent = on ? 'ON' : 'OFF';
        button.classList.toggle('active', on);
        if (saveButton) saveButton.style.display = 'inline-flex';
        recalcTotal();
      });
    });

    const addRelBtn = card.querySelector('.bm-add-rel');
    if (addRelBtn) {
      addRelBtn.addEventListener('click', () => {
        const form = card.querySelector('.rel-add-form');
        if (form) form.style.display = form.style.display === 'none' ? 'grid' : 'none';
      });
    }

    const dedList = card.querySelector('.ded-list');
    const addDed = () => {
      const row = document.createElement('div');
      row.className = 'ded-row';
      row.innerHTML = '<input name="deduction_label" value="" class="bm-input" placeholder="Label"><input name="deduction_amount" value="" class="bm-input number" placeholder="Rp"><button type="button" class="ded-remove" title="Hapus">&times;</button><button type="button" class="ded-add" title="Tambah Potongan">+</button>';
      row.querySelector('.ded-remove').addEventListener('click', () => { row.remove(); if (saveButton) saveButton.style.display = 'inline-flex'; recalcTotal(); });
      row.querySelector('.ded-add').addEventListener('click', addDed);
      row.querySelectorAll('input').forEach((inp) => inp.addEventListener('input', () => { if (saveButton) saveButton.style.display = 'inline-flex'; recalcTotal(); }));
      if (dedList) { dedList.appendChild(row); if (saveButton) saveButton.style.display = 'inline-flex'; recalcTotal(); }
    };
    card.querySelectorAll('.ded-add').forEach((btn) => btn.addEventListener('click', addDed));
    card.querySelectorAll('.ded-remove').forEach((btn) => btn.addEventListener('click', () => { btn.closest('.ded-row').remove(); if (saveButton) saveButton.style.display = 'inline-flex'; recalcTotal(); }));

    if (saveButton) {
      saveButton.addEventListener('click', async () => {
        const data = {};
        card.querySelectorAll('.bon-segment .bm-input').forEach((input) => {
          if (input.name && input.value !== '' && !input.classList.contains('file')) data[input.name] = input.value;
        });
        const pphBtn = card.querySelector('.bm-pph');
        if (pphBtn && !pphBtn.disabled) data.pph_enabled = pphBtn.dataset.enabled;
        // Relasi Agen: jika pilih existing → kirim id; jika isi nama baru → buat relasi baru
        const relSelect = card.querySelector('[name="relation_agent_id"]');
        const newRelName = card.querySelector('[name="new_relation_name"]')?.value?.trim();
        if (relSelect && !relSelect.disabled) {
          if (newRelName) {
            data.relation_agent_id = '';
            data.new_relation_name = newRelName;
            data.new_relation_address = card.querySelector('[name="new_relation_address"]')?.value || '';
          } else {
            data.relation_agent_id = relSelect.value || '';
          }
        }
        saveButton.disabled = true;
        saveButton.textContent = 'Menyimpan...';
        try {
          const response = await fetch(appUrl(`/bon-management/bons/${card.dataset.bonId}`), {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || 'Gagal menyimpan bon');
          card.querySelector('.bon-total').textContent = money(result.bon.total);
          saveButton.style.display = 'none';
          location.reload();
        } catch (error) {
          alert(error.message);
        } finally {
          saveButton.disabled = false;
          saveButton.textContent = 'Simpan Bon';
        }
      });
    }
  });

  document.querySelectorAll('.bm-recalc').forEach((button) => {
    button.addEventListener('click', async () => {
      const segment = button.closest('.nota-segment');
      button.disabled = true;
      button.textContent = '...';
      try {
        const response = await fetch(appUrl(`/bon-management/notas/${segment.dataset.notaId}/recalc`), {
          method: 'POST',
          headers: { Accept: 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Gagal recalc');
        location.reload();
      } catch (error) {
        alert(error.message);
      } finally {
        button.disabled = false;
        button.textContent = 'Recalc';
      }
    });
  });

  document.querySelectorAll('.bm-wa').forEach((button) => {
    button.addEventListener('click', async () => {
      const segment = button.closest('.nota-segment');
      try {
        const response = await fetch(appUrl(`/bon-management/notas/${segment.dataset.notaId}/whatsapp`), {
          headers: { Accept: 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Gagal membuat teks WA');
        await navigator.clipboard.writeText(result.text);
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'WA'; }, 1200);
      } catch (error) {
        alert(error.message);
      }
    });
  });
});
</script>

