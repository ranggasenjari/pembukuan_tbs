<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Nota</p>
    <h1><%= nota ? 'Edit Nota' : 'Buat Nota' %></h1>
  </div>
  <a href="<%= url(nota ? `/notas/${nota.id}` : '/notas') %>" class="btn-secondary">Kembali</a>
</div>
<form method="post" action="<%= url(nota ? `/notas/${nota.id}?_method=PUT` : '/notas') %>" class="space-y-5">
  <section class="form-card">
    <h2>Data Relasi/Agen</h2>
    <div class="grid gap-4 md:grid-cols-2">
      <label>
        <span class="form-label">Relasi / Agen</span>
        <select required name="relation_agent_id" class="form-input">
          <option value="">Pilih Relasi / Agen</option>
          <% (relationAgents || []).forEach((relation) => { %>
            <option value="<%= relation.id %>" <%= nota?.relation_agent_id === relation.id || (!nota?.relation_agent_id && nota?.recipient_name === relation.name) ? 'selected' : '' %>><%= relation.name %></option>
          <% }) %>
        </select>
      </label>
      <div id="relation-info" class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700"></div>
    </div>
  </section>
  <section class="form-card">
    <div class="flex items-center justify-between">
      <h2>Pilih Bon</h2>
      <strong id="nota-total" class="text-emerald-700">Rp 0</strong>
    </div>
    <% if (!bons.length) { %><p class="empty">Tidak ada bon yang tersedia.</p><% } %>
    <div class="mt-4 grid gap-3">
      <% bons.forEach((bon) => { const checked = selectedIds.includes(bon.id); %>
        <label class="select-row">
          <input type="checkbox" name="bon_ids" value="<%= bon.id %>" data-total="<%= bon.total %>" <%= checked ? 'checked' : '' %>>
          <span>
            <strong><%= bon.plate_number %></strong>
            <small><%= format.date(bon.bon_date) %> &bull; <%= format.number(bon.netto_2) %> kg &bull; <%= bon.factories?.name || '-' %> &bull; <%= bon.relation_agents?.name || bon.relation_name || '-' %></small>
          </span>
          <b><%= format.currency(bon.total) %></b>
        </label>
      <% }) %>
    </div>
  </section>
  <button class="btn-primary"><%= nota ? 'Update Nota' : 'Generate Nota' %></button>
</form>
<script>
  window.RELATION_AGENTS = <%- JSON.stringify(relationAgents || []) %>;
</script>
<script src="<%= url('/js/nota-form.js') %>"></script>
<%- include('../partials/footer') %>
