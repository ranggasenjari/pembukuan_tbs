<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Operasional</p>
    <h1>Nota Transaksi</h1>
  </div>
  <a href="/notas/new" class="btn-primary">Buat Nota</a>
</div>
<form class="filter-bar">
  <input type="date" name="start" value="<%= filters.start || '' %>" class="form-input compact">
  <input type="date" name="end" value="<%= filters.end || '' %>" class="form-input compact">
  <input name="q" value="<%= filters.q || '' %>" class="form-input compact" placeholder="Cari driver">
  <button class="btn-secondary">Filter</button>
</form>
<div class="table-card">
  <table>
    <thead><tr><th>Tanggal</th><th>Nomor</th><th>Penerima</th><th>Item</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% if (!notas.length) { %><tr><td colspan="7" class="empty">Belum ada nota.</td></tr><% } %>
      <% notas.forEach((nota) => { %>
        <tr>
          <td><%= format.date(nota.invoice_date) %></td>
          <td class="font-bold"><%= nota.invoice_number %></td>
          <td><%= nota.recipient_name || '-' %></td>
          <td><%= nota.nota_items?.[0]?.count || 0 %></td>
          <td class="font-bold"><%= format.currency(nota.total_amount) %></td>
          <td><span class="status <%= nota.status.toLowerCase() %>"><%= format.statusLabel(nota.status) %></span></td>
          <td class="text-right"><a class="link" href="/notas/<%= nota.id %>">Detail</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
