<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Keuangan</p>
    <h1>Saldo</h1>
    <p class="text-sm text-slate-500">Saldo tersedia: <strong><%= format.currency(balance) %></strong></p>
  </div>
</div>
<section class="grid gap-5 lg:grid-cols-[360px_1fr]">
  <form method="post" action="/deposits" class="form-card">
    <h2>Tambah Saldo</h2>
    <label><span class="form-label">Kategori</span><select name="category" required class="form-input"><option value="piutang">Piutang</option><option value="kredit">Kredit</option></select></label>
    <label><span class="form-label">Keterangan Sumber</span><input name="source" required class="form-input"></label>
    <label><span class="form-label">Besaran</span><input name="amount" type="number" required class="form-input"></label>
    <button class="btn-primary">Simpan Saldo</button>
  </form>
  <div>
    <form class="filter-bar">
      <input type="date" name="start" value="<%= filters.start || '' %>" class="form-input compact">
      <input type="date" name="end" value="<%= filters.end || '' %>" class="form-input compact">
      <select name="category" class="form-input compact">
        <option value="">Semua</option>
        <option value="piutang" <%= filters.category === 'piutang' ? 'selected' : '' %>>Piutang</option>
        <option value="kredit" <%= filters.category === 'kredit' ? 'selected' : '' %>>Kredit</option>
      </select>
      <button class="btn-secondary">Filter</button>
    </form>
    <div class="table-card">
      <table>
        <thead><tr><th>Tanggal</th><th>Sumber</th><th>Kategori</th><th>Jumlah</th><th></th></tr></thead>
        <tbody>
          <% if (!deposits.length) { %><tr><td colspan="5" class="empty">Belum ada saldo.</td></tr><% } %>
          <% deposits.forEach((deposit) => { %>
            <tr>
              <td><%= format.dateTime(deposit.created_at) %></td>
              <td>
                <form id="deposit-<%= deposit.id %>" method="post" action="/deposits/<%= deposit.id %>?_method=PUT" class="grid gap-2 md:grid-cols-2">
                  <input name="source" value="<%= deposit.source %>" class="form-input compact">
                  <input name="amount" type="number" value="<%= deposit.amount %>" class="form-input compact">
                  <input type="hidden" name="category" value="<%= deposit.category || '' %>">
                </form>
              </td>
              <td><%= deposit.category || '-' %></td>
              <td class="font-bold"><%= format.currency(deposit.amount) %></td>
              <td class="text-right">
                <button form="deposit-<%= deposit.id %>" class="link">Update</button>
                <form method="post" action="/deposits/<%= deposit.id %>?_method=DELETE" data-confirm="Hapus saldo ini?" class="inline"><button class="link danger">Hapus</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
