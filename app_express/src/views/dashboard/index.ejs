<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Dashboard</p>
    <h1>Dashboard Transaksi</h1>
    <p class="text-sm text-slate-500">Fokus transaksi harian pada periode terpilih.</p>
  </div>
  <div class="flex flex-wrap items-end gap-2">
    <form class="filter-bar !mb-0">
      <input type="date" name="start" value="<%= filters.start %>" class="form-input compact">
      <input type="date" name="end" value="<%= filters.end %>" class="form-input compact">
      <button class="btn-primary">Filter</button>
    </form>
    <a href="<%= url(`/dashboard?start=${presets.today}&end=${presets.today}`) %>"
       class="btn-secondary <%= filters.start === presets.today && filters.end === presets.today ? 'active' : '' %>">Hari Ini</a>
    <a href="<%= url(`/dashboard?start=${presets.monthStart}&end=${presets.today}`) %>"
       class="btn-secondary <%= filters.start === presets.monthStart && filters.end === presets.today ? 'active' : '' %>">Bulan Ini</a>
  </div>
</div>

<section class="dashboard-hero">
  <div class="dashboard-hero-grid">
    <div>
      <p class="hero-label">Total Transaksi Harian</p>
      <div class="hero-value"><%= format.currency(stats.totalTransactionValue) %></div>
      <p class="hero-meta">Nilai seluruh bon pada periode ini.</p>
    </div>
    <div class="hero-side">
      <a href="<%= url('/bons') %>" class="hero-side-item">
        <span>Total Tonase</span>
        <strong><%= format.number((stats.totalTonnage / 1000).toFixed(1)) %> ton</strong>
      </a>
      <a href="<%= url('/bons') %>" class="hero-side-item">
        <span>Total Bon</span>
        <strong><%= stats.totalBons %> bon</strong>
      </a>
      <a href="<%= url('/payments') %>" class="hero-side-item">
        <span>Total Pembayaran</span>
        <strong><%= format.currency(stats.totalPayments) %></strong>
      </a>
    </div>
  </div>
</section>

<section class="metric-grid">
  <a href="<%= url('/bons') %>" class="metric-card">
    <div class="metric-top">
      <span class="metric-icon teal"><i data-lucide="receipt-text"></i></span>
      <span class="stat-label">Total Bon</span>
    </div>
    <strong><%= stats.totalBons %></strong>
    <small><%= stats.ongoingBons %> aktif, <%= stats.finishedBons %> selesai</small>
  </a>
  <a href="<%= url('/bons') %>" class="metric-card">
    <div class="metric-top">
      <span class="metric-icon blue"><i data-lucide="scale"></i></span>
      <span class="stat-label">Total Tonase</span>
    </div>
    <strong class="text-lg"><%= format.number((stats.totalTonnage / 1000).toFixed(1)) %> ton</strong>
    <small><%= format.number(stats.totalTonnage) %> kg</small>
  </a>
  <a href="<%= url('/payments') %>" class="metric-card">
    <div class="metric-top">
      <span class="metric-icon slate"><i data-lucide="credit-card"></i></span>
      <span class="stat-label">Total Pembayaran</span>
    </div>
    <strong class="text-lg"><%= format.currency(stats.totalPayments) %></strong>
    <small>Pembayaran diterima pada periode ini</small>
  </a>
  <a href="<%= url('/margins') %>" class="metric-card">
    <div class="metric-top">
      <span class="metric-icon amber"><i data-lucide="piggy-bank"></i></span>
      <span class="stat-label">Margin / Profit</span>
    </div>
    <strong class="text-lg"><%= format.currency(stats.totalMargin) %></strong>
    <small>Laba bersih periode: <%= format.currency(stats.netProfit) %></small>
  </a>
</section>

<section class="panel-card mt-5 p-5">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-lg font-black text-slate-950">Bon per Pabrik</h2>
      <p class="text-sm text-slate-500">Sebaran jumlah bon, tonase, dan nilai per pabrik pada periode ini.</p>
    </div>
  </div>
  <% if ((stats.factoryBreakdown || []).length === 0) { %>
    <p class="text-sm text-slate-500">Belum ada bon pada periode ini.</p>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-slate-400">
            <th class="pb-2">Pabrik</th>
            <th class="pb-2 text-right">Bon</th>
            <th class="pb-2 text-right">Tonase</th>
            <th class="pb-2 text-right">Nilai</th>
          </tr>
        </thead>
        <tbody>
          <% (stats.factoryBreakdown || []).forEach((factory) => { %>
            <tr class="border-t border-slate-100">
              <td class="py-2 font-semibold text-slate-800"><%= factory.name %></td>
              <td class="py-2 text-right"><%= factory.count %></td>
              <td class="py-2 text-right"><%= format.number((factory.tonnage / 1000).toFixed(1)) %> ton</td>
              <td class="py-2 text-right font-semibold"><%= format.currency(factory.value) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<% if (stats.totalPayments > 0 || stats.totalMargin > 0) { %>
<section class="panel-card mt-5 p-5">
  <div class="mb-4">
    <h2 class="text-lg font-black text-slate-950">Analisis Keuangan</h2>
    <p class="text-sm text-slate-500">Perbandingan transaksi, biaya, dan hasil bersih.</p>
  </div>
  <div class="analysis-grid">
    <div class="analysis-item">
      <span>Total Transaksi (Offtaker)</span>
      <strong><%= format.currency(stats.totalTransactions) %></strong>
    </div>
    <div class="analysis-item">
      <span>Total Pembayaran</span>
      <strong><%= format.currency(stats.totalPayments) %></strong>
    </div>
    <div class="analysis-item">
      <span>Margin / Profit</span>
      <strong class="text-emerald-700"><%= format.currency(stats.totalMargin) %></strong>
    </div>
    <div class="analysis-item">
      <span>Pengeluaran</span>
      <strong><%= format.currency(stats.totalExpenses) %></strong>
    </div>
    <div class="analysis-item">
      <span>Net Profit</span>
      <strong class="text-emerald-700"><%= format.currency(stats.netProfit) %></strong>
    </div>
  </div>
</section>
<% } %>
<%- include('../partials/footer') %>