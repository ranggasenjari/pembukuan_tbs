<%- include('../partials/header') %>
<% const b = bon || {}; const locked = bon && bon.status !== 'BELUM_DIBAYAR'; const deductions = (b.bon_deductions && b.bon_deductions.length ? b.bon_deductions : [{label:'', amount:0}]); %>
<div class="page-head">
  <div>
    <p class="eyebrow">Slip Timbangan</p>
    <h1><%= bon ? 'Edit Bon' : 'Tambah Bon' %></h1>
  </div>
  <a href="<%= url(bon ? `/bons/${bon.id}` : '/bons') %>" class="btn-secondary">Kembali</a>
</div>

<% if (locked) { %>
  <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-800">Data bon ini terkunci karena sudah diproses.</div>
<% } %>

<form id="bon-form" method="post" enctype="multipart/form-data" action="<%= url(bon ? `/bons/${bon.id}?_method=PUT` : '/bons') %>" class="bon-form-page">
  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="space-y-2 min-w-0">

      <section class="form-card bon-card">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="!mb-0">Foto dan OCR</h2>
          <% if (b.image_url) { %><a href="<%= b.image_url %>" target="_blank" class="link text-xs">Lihat foto tersimpan</a><% } %>
        </div>
        <% if (!locked) { %>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <input id="bon-image" type="file" name="image" accept="image/*" class="form-input max-w-md bon-sm" style="margin-top:0">
            <button type="button" id="ocr-button" class="btn-secondary small">Baca OCR</button>
            <span id="ocr-status" class="text-sm text-slate-500"></span>
          </div>
        <% } %>
        <div class="mt-3 lg:hidden">
          <div id="bon-photo-box-sm" class="bon-photo-sm">
            <img id="bon-photo-sm" class="bon-photo-clickable hidden" alt="Foto bon">
            <div id="bon-photo-placeholder-sm" class="bon-photo-empty">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              <p>Foto bon tampil di sini setelah OCR / unggah foto.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="form-card bon-card">
        <h2>Data Timbangan</h2>
        <div class="grid grid-cols-2 gap-2 md:grid-cols-3 lg:grid-cols-4">
          <label><span class="form-label">Nomor Tiket</span><input name="ticket_number" value="<%= b.ticket_number || '' %>" class="form-input bon-sm uppercase" <%= locked ? 'readonly' : '' %>></label>
          <label><span class="form-label">Tanggal Bon</span><input type="date" name="bon_date" value="<%= b.bon_date ? format.dateInput(b.bon_date) : today %>" required class="form-input bon-sm" <%= locked ? 'readonly' : '' %>></label>
          <label><span class="form-label">Plat Nomor</span><input name="plate_number" value="<%= b.plate_number || '' %>" required class="form-input bon-sm uppercase" <%= locked ? 'readonly' : '' %>></label>
          <label><span class="form-label">Nama Supir</span><input name="driver_name" value="<%= b.driver_name || '' %>" class="form-input bon-sm uppercase" <%= locked ? 'readonly' : '' %>></label>
          <label class="col-span-2">
            <span class="form-label">Relasi</span>
            <% if (locked) { %>
              <input type="text" value="<%= b.relation_name || '' %>" readonly class="form-input bon-sm uppercase">
              <input type="hidden" name="relation_agent_id" value="<%= b.relation_agent_id || '' %>">
            <% } else { %>
              <div class="flex gap-2">
                <div class="relative flex-1 relation-combobox">
                  <input id="relation-search" type="text" class="form-input bon-sm" placeholder="Ketik nama relasi untuk mencari..." autocomplete="off">
                  <button type="button" id="relation-clear" class="relation-clear hidden" title="Kosongkan">×</button>
                  <select id="relation-select" name="relation_agent_id" class="hidden">
                    <option value="">Pilih Relasi / Agen</option>
                    <% (relationAgents || []).forEach((relation) => { %>
                      <option value="<%= relation.id %>" <%= b.relation_agent_id === relation.id || (!b.relation_agent_id && b.relation_name === relation.name) ? 'selected' : '' %>><%= relation.name %></option>
                    <% }) %>
                  </select>
                  <div id="relation-list" class="relation-list hidden"></div>
                </div>
                <button type="button" id="add-relation-btn" class="btn-secondary small px-3" title="Tambah Relasi Baru">+</button>
              </div>
            <% } %>
            <input type="hidden" name="relation_name" value="<%= b.relation_name || '' %>">
          </label>
          <label>
            <span class="form-label">Pabrik</span>
            <select name="factory_id" class="form-input bon-sm" <%= locked ? 'disabled' : '' %>>
              <option value="">Tanpa Pabrik</option>
              <% (factories || []).forEach((factory) => { %>
                <option value="<%= factory.id %>" <%= b.factory_id === factory.id ? 'selected' : '' %>><%= factory.name %></option>
              <% }) %>
            </select>
            <input type="hidden" name="factory_name" value="<%= b.factories?.name || '' %>">
          </label>
          <label>
            <span class="form-label">Jenis SPSI</span>
            <select name="factory_spsi_type_id" class="form-input bon-sm" <%= locked ? 'disabled' : '' %>>
              <option value="">Pilih Jenis SPSI</option>
            </select>
            <input type="hidden" name="spsi_type_name" value="<%= b.spsi_type_name || '' %>">
            <input type="hidden" name="spsi_calculation_mode" value="<%= b.spsi_calculation_mode || 'PER_KG' %>">
            <input type="hidden" name="spsi_rate" value="<%= b.spsi_rate ?? b.biaya_bongkar ?? 12 %>">
          </label>
          <label><span class="form-label">Asal Buah</span><input name="fruit_origin" value="<%= b.fruit_origin || '' %>" class="form-input bon-sm uppercase" <%= locked ? 'readonly' : '' %>></label>
          <label><span class="form-label">Netto 1</span><input name="netto_1" value="<%= b.netto_1 || 0 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc" <%= locked ? 'readonly' : '' %>></label>
          <label><span class="form-label">Netto 2</span><input name="netto_2" value="<%= b.netto_2 || 0 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc" <%= locked ? 'readonly' : '' %>></label>
          <label class="bon-price-wrap">
            <span class="form-label">Harga</span>
            <div class="bon-stepper">
              <button type="button" class="bon-stepper-btn" data-step="-10" aria-label="Kurangi harga">−</button>
              <input name="price" value="<%= b.price || latestPrice || 0 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc bon-stepper-input" <%= locked ? 'readonly' : '' %>>
              <button type="button" class="bon-stepper-btn" data-step="10" aria-label="Tambah harga">+</button>
            </div>
            <div id="factory-price-pills" class="mt-1 flex flex-wrap gap-1"></div>
          </label>
        </div>
      </section>

      <section class="form-card bon-card">
        <div class="flex items-center justify-between">
          <h2 class="!mb-0">Potongan</h2>
          <% if (!locked) { %><button type="button" id="add-deduction" class="btn-secondary small">Tambah Potongan</button><% } %>
        </div>
        <div class="mt-2 grid grid-cols-2 gap-2 md:grid-cols-5">
          <label><span class="form-label">DP / Panjar</span><input name="dp" value="<%= b.dp || 0 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc" <%= locked ? 'readonly' : '' %>></label>
          <label><span id="biaya-bongkar-label" class="form-label">Bongkar (Rp/Kg)</span><input name="biaya_bongkar" value="<%= b.spsi_rate ?? b.biaya_bongkar ?? 12 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc" <%= locked ? 'readonly' : '' %>></label>
          <label><span class="form-label">BP / Colt</span><input name="bp_colt" value="<%= b.bp_colt ?? 100000 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc" <%= locked ? 'readonly' : '' %>></label>
          <label><span class="form-label">PPh 0.25%</span><input name="pph" value="<%= b.pph || 0 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc" <%= locked ? 'readonly' : '' %>></label>
          <label><span class="form-label">Uang Minum</span><input name="uang_minum" value="<%= b.uang_minum ?? 10000 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc" <%= locked ? 'readonly' : '' %>></label>
        </div>
        <div id="deductions" class="mt-2 space-y-1.5">
          <% deductions.forEach((d) => { %>
            <div class="deduction-row grid gap-2 md:grid-cols-[1fr_200px_40px]">
              <input name="deduction_label" value="<%= d.label || '' %>" class="form-input bon-sm" placeholder="Nama potongan" <%= locked ? 'readonly' : '' %>>
              <input name="deduction_amount" value="<%= d.amount || 0 %>" type="number" inputmode="numeric" class="form-input bon-sm bon-calc deduction-amount" <%= locked ? 'readonly' : '' %>>
              <% if (!locked) { %><button type="button" class="remove-deduction rounded-lg bg-rose-50 text-rose-700">×</button><% } %>
            </div>
          <% }) %>
        </div>
        <div class="mt-2 grid grid-cols-3 gap-2 rounded-lg bg-slate-50 p-2">
          <div><span class="text-[11px] text-slate-500">Subtotal</span><strong id="subtotal-display" class="block text-sm">Rp 0</strong></div>
          <div><span class="text-[11px] text-slate-500">Total Potongan</span><strong id="deduction-display" class="block text-sm">Rp 0</strong><small id="spsi-display" class="block text-[11px] text-slate-500"></small></div>
          <div><span class="text-[11px] text-slate-500">Total Dibayar</span><strong id="total-display" class="block text-lg text-emerald-700">Rp 0</strong></div>
        </div>
      </section>

      <section class="form-card bon-card">
        <h2>Catatan<%= !bon ? ' & Nota Cepat' : '' %></h2>
        <div class="grid gap-2 md:grid-cols-[minmax(0,1fr)_280px]">
          <textarea name="notes" rows="1" class="form-input bon-sm" <%= locked ? 'readonly' : '' %> placeholder="Catatan tambahan..."><%= b.notes || '' %></textarea>
          <% if (!bon) { %>
            <label>
              <span class="form-label">Relasi/Agen Nota</span>
              <select name="quick_relation_agent_id" class="form-input bon-sm">
                <option value="">Ikuti Relasi Bon</option>
                <% (relationAgents || []).forEach((relation) => { %>
                  <option value="<%= relation.id %>"><%= relation.name %></option>
                <% }) %>
              </select>
            </label>
          <% } %>
        </div>
      </section>

      <% if (!locked) { %>
        <div class="flex flex-wrap gap-3">
          <button name="intent" value="save" class="btn-primary">Simpan</button>
          <% if (!bon) { %><button name="intent" value="save_share" class="btn-secondary">Simpan & Buat Nota</button><% } %>
        </div>
      <% } %>
    </div>

    <aside class="bon-photo-pane hidden lg:flex">
      <div class="flex items-baseline justify-between px-3 py-2 border-b border-slate-100">
        <span class="text-sm font-bold">Foto Referensi</span>
        <span class="text-[10px] uppercase tracking-wide text-slate-400">klik untuk zoom</span>
      </div>
      <div class="bon-photo-pane-body">
        <img id="bon-photo" class="bon-photo-clickable hidden" alt="Foto bon">
        <div id="bon-photo-placeholder" class="bon-photo-empty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <p>Foto bon akan tampil di sini setelah OCR / unggah file.</p>
        </div>
      </div>
    </aside>
  </div>
<input type="hidden" name="ocr_image_url" value="">
</form>
<% if (!locked) { %>
<dialog id="add-relation-dialog" class="rounded-xl shadow-xl p-6 max-w-md">
  <h3 class="text-lg font-bold mb-4">Tambah Relasi Baru</h3>
  <div class="space-y-3">
    <input id="new-relation-name" class="form-input uppercase" placeholder="Nama Relasi / Agen">
    <input id="new-relation-contact" class="form-input" placeholder="Kontak (opsional)">
  </div>
  <div class="flex gap-2 mt-5 justify-end">
    <button type="button" id="cancel-add-relation" class="btn-secondary">Batal</button>
    <button type="button" id="confirm-add-relation" class="btn-primary">Simpan</button>
  </div>
</dialog>
<% } %>
<style>
  .content-wrap { padding-top: 14px; padding-bottom: 20px; }
  .page-head { margin-bottom: 10px; }
  .page-head h1 { font-size: 1.5rem; }
  .form-card.bon-card { padding: 10px 12px; }
  .form-card.bon-card h2 { font-size: .85rem; margin-bottom: 8px; }
  .form-input.bon-sm { min-height: 30px; padding: .22rem .5rem; font-size: .8rem; margin-top: .2rem; border-radius: 7px; }
  .bon-stepper { display: flex; align-items: stretch; margin-top: .2rem; }
  .bon-stepper .bon-stepper-input { margin-top: 0; text-align: right; }
  .bon-stepper-btn {
    width: 30px; min-height: 30px; flex: none; border: 1px solid #d0d5dd; background: var(--surface);
    color: var(--text); font-size: 1rem; line-height: 1; cursor: pointer;
  }
  .bon-stepper-btn:first-child { border-radius: 7px 0 0 7px; border-right: 0; }
  .bon-stepper-btn:last-child { border-radius: 0 7px 7px 0; border-left: 0; }
  .bon-stepper-btn:hover { background: var(--surface-soft); }
  .bon-stepper-input { border-radius: 0 !important; }
  .relation-combobox input { padding-right: 30px; }
  .relation-clear {
    position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
    border: 0; background: transparent; color: #94a3b8; cursor: pointer; font-size: 1rem; line-height: 1;
  }
  .relation-list {
    position: absolute; z-index: 50; top: 100%; left: 0; right: 0; margin-top: 2px;
    max-height: 220px; overflow-y: auto; background: #fff; border: 1px solid #d0d5dd;
    border-radius: 8px; box-shadow: 0 8px 24px rgb(15 23 42 / 0.12);
  }
  .relation-list-label { padding: 6px 10px 2px; font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; color: #94a3b8; }
  .relation-list-item {
    display: block; width: 100%; text-align: left; padding: 7px 10px; font-size: .8rem;
    background: #fff; border: 0; cursor: pointer; color: var(--text);
  }
  .relation-list-item:hover { background: #f1f5f9; }
  .relation-list-item.active { background: #eef2ff; color: #4338ca; font-weight: 600; }
  .price-pill {
    border: 1px solid #d0d5dd; background: var(--surface); color: var(--text);
    border-radius: 999px; padding: 2px 10px; font-size: .72rem; cursor: pointer; line-height: 1.4;
  }
  .price-pill:hover { background: #eef2ff; border-color: #a5b4fc; }
  .price-pill.active { background: #4338ca; border-color: #4338ca; color: #fff; font-weight: 600; }
  .bon-photo-pane {
    position: sticky; top: 90px; align-self: start; height: calc(100vh - 120px);
    flex-direction: column; background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden;
  }
  .bon-photo-pane-body { flex: 1; position: relative; display: flex; align-items: center; justify-content: center; background: #0f172a; overflow: hidden; }
  .bon-photo-pane-body img { max-width: 100%; max-height: 100%; object-fit: contain; cursor: zoom-in; }
  .bon-photo-sm { position: relative; aspect-ratio: 4 / 3; border-radius: 10px; background: #0f172a; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: zoom-in; color: #cbd5e1; }
  .bon-photo-sm img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .bon-photo-empty { padding: 20px; text-align: center; color: #94a3b8; font-size: .78rem; line-height: 1.5; }
  .bon-photo-empty svg { margin: 0 auto 8px; opacity: .6; }
  #bon-photo-lightbox {
    position: fixed; inset: 0; z-index: 10050; display: flex; align-items: center; justify-content: center;
    background: rgba(2, 6, 23, 0.92); touch-action: none; user-select: none;
  }
  #bon-photo-lightbox.hidden { display: none; }
  #bon-photo-lightbox img {
    max-width: 92vw; max-height: 86vh; transform-origin: center; will-change: transform;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.5); border-radius: 4px;
  }
  .pb-toolbar {
    position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 6px; background: rgb(15 23 42 / 0.9);
    border: 1px solid rgb(51 65 85 / 0.8); border-radius: 999px; padding: 6px 12px; z-index: 10060;
  }
  .pb-tool-btn {
    width: 34px; height: 34px; border-radius: 999px; border: 1px solid #334155; background: #1e293b;
    color: #e2e8f0; font-size: 1rem; line-height: 1; cursor: pointer;
  }
  .pb-tool-btn:hover { background: #334155; }
  .pb-tool-btn.pb-close { background: #7f1d1d; border-color: #991b1b; }
  .pb-zoom-label { color: #cbd5e1; font-size: .72rem; min-width: 44px; text-align: center; font-variant-numeric: tabular-nums; }
</style>
<script>
  window.RELATION_AGENTS = <%- JSON.stringify(relationAgents || []) %>;
  window.FACTORIES = <%- JSON.stringify(factories || []) %>;
  window.CURRENT_BON_DRIVER = <%- JSON.stringify(b.driver_name || '') %>;
  window.CURRENT_BON_PLATE = <%- JSON.stringify(b.plate_number || '') %>;
  window.CURRENT_BON_SPSI_TYPE_ID = <%- JSON.stringify(b.factory_spsi_type_id || '') %>;
  window.VEHICLE_MAP = <%- JSON.stringify(vehicleMap || {}) %>;
  window.FACTORY_DEFAULT_PRICES = <%- JSON.stringify(factoryDefaultPrices || {}) %>;
  window.BON_INITIAL_IMAGE = <%- JSON.stringify(b.image_url || '') %>;
</script>
<% if (!locked) { %>
<script>
document.querySelector('[name="plate_number"]')?.addEventListener('blur', function() {
  if (typeof isPengurusFactory === 'function' && isPengurusFactory()) return;
  if (!window.VEHICLE_MAP) return;
  const plate = this.value.replace(/\s+/g, '').toUpperCase();
  const potongan = window.VEHICLE_MAP[plate];
  if (potongan) {
    const bpInput = document.querySelector('[name="bp_colt"]');
    if (bpInput) bpInput.value = potongan;
  }
});
document.addEventListener('click', (e) => {
  const btn = e.target.closest('.bon-stepper-btn');
  if (!btn) return;
  const priceInput = document.querySelector('[name="price"]');
  if (!priceInput || priceInput.readOnly) return;
  const step = Number(btn.dataset.step);
  const current = Number(String(priceInput.value).replace(/[^\d.-]/g, '')) || 0;
  priceInput.value = Math.max(0, Math.round((current + step) / 10) * 10);
  priceInput.dispatchEvent(new Event('input'));
});
</script>
<% } %>
<script src="<%= url('/js/bon-form.js') %>"></script>
<script src="<%= url('/js/drop-ocr.js') %>"></script>
<script src="<%= url('/js/photo-viewer.js') %>"></script>
<% if (!locked) { %>
<script>
document.getElementById('add-relation-btn')?.addEventListener('click', () => {
  document.getElementById('add-relation-dialog').showModal();
});
document.getElementById('cancel-add-relation')?.addEventListener('click', () => {
  document.getElementById('add-relation-dialog').close();
});
document.getElementById('confirm-add-relation')?.addEventListener('click', async () => {
  const name = String(document.getElementById('new-relation-name')?.value || '').trim().toUpperCase();
  if (!name) { alert('Nama relasi wajib diisi.'); return; }
  const contact = String(document.getElementById('new-relation-contact')?.value || '').trim();
  try {
    const res = await fetch(window.appUrl ? window.appUrl('/relation-agents') : '/relation-agents', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: new URLSearchParams({ name, contact })
    });
    if (!res.ok) { alert('Gagal menyimpan relasi.'); return; }
    let created = null;
    try { created = await res.json(); } catch { /* respons bukan JSON */ }
    const id = created?.id || '';
    const relName = created?.name || name;

    const select = document.getElementById('relation-select');
    if (id) {
      window.RELATION_AGENTS = window.RELATION_AGENTS || [];
      if (!window.RELATION_AGENTS.some((r) => r.id === id)) {
        window.RELATION_AGENTS.push({ id, name: relName, contact: created?.contact || contact || null });
      }
      if (select) {
        const option = document.createElement('option');
        option.value = id;
        option.textContent = relName;
        select.appendChild(option);
        select.value = id;
        if (typeof syncRelationCombobox === 'function') syncRelationCombobox();
        if (typeof setRelationName === 'function') setRelationName(true);
      }
    }
    if (!select) {
      document.querySelector('[name="relation_name"]').value = relName;
    }
    document.getElementById('add-relation-dialog').close();
    document.getElementById('new-relation-name').value = '';
    document.getElementById('new-relation-contact').value = '';
  } catch (e) { alert('Error: ' + e.message); }
});
</script>
<% } %>
<%- include('../partials/footer') %>