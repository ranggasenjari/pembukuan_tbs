<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Detail Bon</p>
    <h1><%= bon.ticket_number || bon.plate_number %></h1>
  </div>
  <div class="flex gap-2">
    <% if (bon.status === 'BELUM_DIBAYAR') { %>
      <a href="<%= url(`/bons/${bon.id}/edit`) %>" class="btn-secondary">Edit</a>
      <form method="post" action="<%= url(`/bons/${bon.id}?_method=DELETE`) %>" data-confirm="Hapus bon ini?">
        <button class="btn-danger">Hapus</button>
      </form>
    <% } %>
    <a href="<%= url('/bons') %>" class="btn-secondary">Kembali</a>
  </div>
</div>

<section class="grid gap-5 lg:grid-cols-[1.5fr_1fr]">
  <div class="form-card">
    <h2>Informasi</h2>
    <dl class="detail-grid">
      <dt>Tanggal</dt><dd><%= format.date(bon.bon_date) %></dd>
      <dt>Plat</dt><dd><%= bon.plate_number %></dd>
      <dt>Driver</dt><dd><%= bon.driver_name || '-' %></dd>
      <dt>Relasi</dt><dd><%= bon.relation_name || '-' %></dd>
      <dt>Pabrik</dt><dd><%= bon.factories?.name || '-' %></dd>
      <dt>Jenis SPSI</dt><dd><%= bon.spsi_type_name || (bon.factory_id ? '-' : 'Manual per kg') %></dd>
      <dt>Netto 1 / 2</dt><dd><%= format.number(bon.netto_1) %> / <%= format.number(bon.netto_2) %> kg</dd>
      <dt>Harga</dt><dd><%= format.currency(bon.price) %></dd>
      <dt>SPSI</dt><dd><%= format.currency(bon.spsi_amount ?? ((bon.biaya_bongkar || 0) * (bon.netto_1 || 0))) %></dd>
      <dt>Status</dt>
      <dd>
        <span class="status <%= bon.status.toLowerCase() %>" title="<%= format.bonStatusDescription(bon.status) %>"><%= format.bonStatusLabel(bon.status) %></span>
        <small class="mt-1 block text-xs text-slate-500"><%= format.bonStatusDescription(bon.status) %></small>
      </dd>
    </dl>
  </div>
  <div class="form-card">
    <h2>Total</h2>
    <p class="text-3xl font-black text-emerald-700"><%= format.currency(bon.total) %></p>
    <% const deductions = bon.bon_deductions || []; %>
    <% if (deductions.length) { %>
      <div class="mt-2 text-sm text-slate-500">
        <% deductions.forEach((d) => { %>
          <div><%= d.label || 'Potongan' %>: <%= format.currency(d.amount) %></div>
        <% }) %>
      </div>
    <% } %>
    <% if (bon.image_url) { %><a href="<%= bon.image_url %>" target="_blank" class="mt-4 inline-flex btn-secondary">Lihat Foto</a><% } %>
  </div>
</section>

<section class="mt-5 form-card">
  <h2>Sub Nota</h2>
  <% if (!subNotas.length) { %>
    <p class="empty">Belum ada sub nota untuk bon ini.</p>
  <% } %>
  <table class="table-auto w-full text-sm mb-4">
    <thead>
      <tr class="text-left text-slate-500">
        <th class="py-1 pr-2">Nama</th>
        <th class="py-1 pr-2">Harga (Rp/kg)</th>
        <th class="py-1 pr-2">Netto 2</th>
        <th class="py-1 pr-2">Total</th>
        <th class="py-1"></th>
      </tr>
    </thead>
    <tbody>
      <% subNotas.forEach((sub) => { %>
        <tr class="border-t border-slate-100">
          <td class="py-2 pr-2 font-medium"><%= sub.name %></td>
          <td class="py-2 pr-2"><%= format.number(sub.price_per_kg) %></td>
          <td class="py-2 pr-2"><%= format.number(sub.netto_2) %> kg</td>
          <td class="py-2 pr-2 font-bold"><%= format.currency(sub.amount) %></td>
          <td class="py-2 text-right">
            <form method="post" action="<%= url(`/bons/sub-notas/${sub.id}?_method=DELETE`) %>" data-confirm="Hapus sub nota ini?">
              <button class="text-red-600 hover:underline text-xs">Hapus</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <form method="post" action="<%= url(`/bons/${bon.id}/sub-notas`) %>" class="grid gap-3 md:grid-cols-4">
    <div>
      <span class="form-label">Nama</span>
      <input name="name" required class="form-input uppercase" placeholder="Contoh: ANU" />
    </div>
    <div>
      <span class="form-label">Harga (Rp/kg)</span>
      <input name="price_per_kg" type="number" min="1" step="1" required class="form-input" placeholder="Contoh: 40" />
    </div>
    <div>
      <span class="form-label">Catatan</span>
      <input name="notes" class="form-input" placeholder="Opsional" />
    </div>
    <div class="flex items-end">
      <button class="btn-primary">Tambah</button>
    </div>
    <p class="text-xs text-slate-500 md:col-span-4">Total otomatis = Netto 2 × Harga, tanpa potongan.</p>
  </form>
</section>

<% if (related.notas.length || related.payments.length) { %>
<section class="mt-5 form-card">
  <h2>Dokumen Terkait</h2>
  <div class="grid gap-3 md:grid-cols-2">
    <% related.notas.forEach((nota) => { %>
      <a href="<%= url(`/notas/${nota.id}`) %>" class="rounded-lg border border-slate-200 p-4 hover:bg-slate-50">
        <strong>Nota <%= nota.invoice_number %></strong>
        <div class="text-sm text-slate-500"><%= format.currency(nota.total_amount) %></div>
      </a>
    <% }) %>
    <% related.payments.forEach((payment) => { %>
      <a href="<%= payment.proof_url || '#' %>" target="_blank" class="rounded-lg border border-slate-200 p-4 hover:bg-slate-50">
        <strong>Pembayaran</strong>
        <div class="text-sm text-slate-500"><%= format.currency(payment.amount_paid) %></div>
      </a>
    <% }) %>
  </div>
</section>
<% } %>
<%- include('../partials/footer') %>
