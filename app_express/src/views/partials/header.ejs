<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title ? `${title} - Pembukuan TBS` : 'Pembukuan TBS' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
  <script>
    window.APP_BASE_PATH = <%- JSON.stringify(basePath || '') %>;
    window.appUrl = (path) => `${window.APP_BASE_PATH || ''}${String(path || '/').startsWith('/') ? path : `/${path}`}`;
  </script>
  <link rel="stylesheet" href="<%= url('/css/app.css') %>">
</head>
<body class="app-body">
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <%- include('./nav') %>
    <main class="app-main">
      <div class="app-topbar">
        <div>
          <button id="sidebar-toggle" class="topbar-hamburger" aria-label="Toggle sidebar">☰</button>
        </div>
        <div class="topbar-actions">
          <a href="<%= url('/bons/new') %>" class="topbar-action"><i data-lucide="receipt-text"></i><span>Input Bon</span></a>
          <a href="<%= url('/payments/new') %>" class="topbar-action secondary"><i data-lucide="wallet-cards"></i><span>Bayar Nota</span></a>
        </div>
      </div>
      <div class="content-wrap">
        <%- include('./messages') %>
  <% } else { %>
    <main>
  <% } %>
  <style>
    .app-body.sidebar-collapsed .app-main { padding-left:0!important; }
    .app-body.sidebar-collapsed .app-sidebar { width:0!important; overflow:hidden; padding:0; }
    .topbar-hamburger { background:none; border:none; font-size:1.3rem; cursor:pointer; padding:4px 8px; margin-right:8px; color:#475467; display:inline-block; vertical-align:middle; }
    .topbar-hamburger:hover { color:#111827; }
  </style>
  <script>
    document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
      document.body.classList.toggle('sidebar-collapsed');
    });
  </script>
