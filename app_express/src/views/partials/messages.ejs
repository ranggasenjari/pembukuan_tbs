<% if (flash && flash.success) { %>
  <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"><%= flash.success %></div>
<% } %>
<% if (flash && flash.error) { %>
  <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800"><%= flash.error %></div>
<% } %>
