<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Relasi Bayar</p>
    <h1><%= paymentRelation.name %></h1>
  </div>
  <div class="flex gap-2">
    <a href="<%= url(`/payment-relations/${paymentRelation.id}/edit`) %>" class="btn-secondary">Edit</a>
    <a href="<%= url('/payment-relations') %>" class="btn-secondary">Kembali</a>
  </div>
</div>

<section class="form-card">
  <h2>Informasi Relasi Bayar</h2>
  <dl class="detail-list">
    <dt>Nama</dt><dd><%= paymentRelation.name %></dd>
    <dt>Kontak</dt><dd><%= paymentRelation.contact || '-' %></dd>
    <dt>Alamat / Asal</dt><dd><%= paymentRelation.address || '-' %></dd>
    <dt>Fee</dt><dd><%= paymentRelation.fee != null ? format.currency(paymentRelation.fee) : '-' %></dd>
    <dt>Potongan BP</dt><dd><%= paymentRelation.potongan_bp != null ? format.currency(paymentRelation.potongan_bp) : '-' %></dd>
    <dt>Harga / Kg</dt><dd><%= paymentRelation.harga != null ? format.number(paymentRelation.harga) : '-' %></dd>
    <dt>Uang Minum</dt><dd><%= paymentRelation.uang_minum != null ? format.currency(paymentRelation.uang_minum) : '-' %></dd>
    <dt>Catatan</dt><dd><%= paymentRelation.notes || '-' %></dd>
  </dl>
</section>

<div class="grid gap-5 lg:grid-cols-2 mt-5">
  <section class="form-card">
    <h2>Kendaraan</h2>
    <% const vehicles = paymentRelation.payment_relation_vehicles || []; %>
    <% if (!vehicles.length) { %><p class="empty">Belum ada kendaraan.</p><% } %>
    <div class="space-y-3">
      <% vehicles.forEach((row) => { const vehicle = row.vehicles || {}; %>
        <div class="select-row">
          <span><strong><%= vehicle.plate_number || '-' %></strong><small><%= vehicle.driver_name || '-' %></small></span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="form-card">
    <h2>Rekening</h2>
    <% const accounts = paymentRelation.payment_relation_accounts || []; %>
    <% if (!accounts.length) { %><p class="empty">Belum ada rekening.</p><% } %>
    <div class="space-y-3">
      <% accounts.forEach((account) => { %>
        <div class="select-row">
          <span>
            <strong><%= account.bank_name || '-' %></strong>
            <small><%= account.account_number || '-' %> - <%= account.account_name || '-' %></small>
          </span>
        </div>
      <% }) %>
    </div>
  </section>
</div>

<div class="grid gap-5 lg:grid-cols-2 mt-5">
  <section class="form-card">
    <h2>Hutang</h2>
    <% const hutang = paymentRelation.payment_relation_hutang || []; %>
    <% if (!hutang.length) { %><p class="empty">Belum ada data hutang.</p><% } %>
    <div class="space-y-3">
      <% hutang.forEach((row) => { %>
        <div class="select-row">
          <span>
            <strong><%= format.currency(row.amount) %></strong>
            <small><%= format.date(row.tanggal) %><%= row.notes ? ` — ${row.notes}` : '' %></small>
          </span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="form-card">
    <h2>Rolling</h2>
    <% const rolling = paymentRelation.payment_relation_rolling || []; %>
    <% if (!rolling.length) { %><p class="empty">Belum ada data rolling.</p><% } %>
    <div class="space-y-3">
      <% rolling.forEach((row) => { %>
        <div class="select-row">
          <span>
            <strong><%= format.currency(row.amount) %></strong>
            <small><%= format.date(row.tanggal) %><%= row.notes ? ` — ${row.notes}` : '' %></small>
          </span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="form-card lg:col-span-2">
    <h2>Giringan</h2>
    <% const giringan = paymentRelation.payment_relation_giringan || []; %>
    <% if (!giringan.length) { %><p class="empty">Belum ada nama giringan.</p><% } %>
    <div class="space-y-3">
      <% giringan.forEach((row) => { %>
        <div class="select-row"><span><strong><%= row.name %></strong></span></div>
      <% }) %>
    </div>
  </section>
</div>

<form method="post" action="<%= url(`/payment-relations/${paymentRelation.id}?_method=DELETE`) %>" data-confirm="Hapus relasi bayar ini?" class="mt-5">
  <button class="link danger">Hapus Relasi Bayar</button>
</form>
<%- include('../partials/footer') %>
