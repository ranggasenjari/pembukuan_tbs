    "express-session": "^1.18.2",
    "method-override": "^3.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "vitest": "^4.0.15"
